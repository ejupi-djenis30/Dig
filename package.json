{
  "name": "dig-gopher-explorer",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A bounded Gopher client, local gateway, and protocol inspector.",
  "bin": {
    "dig-gopher": "./bin/dig.mjs"
  },
  "files": [
    "bin",
    "src",
    "site",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node ./bin/dig.mjs serve",
    "dev": "node ./scripts/serve-test-app.mjs",
    "fixture": "node ./scripts/gopher-fixture.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check:site": "node ./scripts/validate-site.mjs",
    "check:release": "node ./scripts/validate-release.mjs",
    "check": "npm test && npm run check:site && npm run check:release"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
